{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "stripInternal": true
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/core/src/**/*.tsx",
    "packages/react/src/**/*.ts",
    "packages/react/src/**/*.tsx"
  ],
  "exclude": ["**/tests", "**/dist"]
}
