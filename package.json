{
  "private": true,
  "name": "shikitor-workspace",
  "packageManager": "pnpm@8.15.9",
  "version": "1.0.2",
  "license": "MIT",
  "description": "shikitor workspace",
  "homepage": "https://oneworks-ai.github.io/shikitor",
  "repository": "https://github.com/oneworks-ai/shikitor",
  "scripts": {
    "release:core": "pnpm --filter @shikitor/core publish --access public --no-git-checks",
    "release:react": "pnpm --filter @shikitor/react publish --access public --no-git-checks",
    "release:dsh": "pnpm --filter dsh-shikitor publish --access public --no-git-checks",
    "release:packages": "pnpm release:core && pnpm release:react && pnpm release:dsh"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "jiek": "0.4.7",
    "esbuild-register": "^3.5.0",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0",
    "standard": "workspace:*"
  }
}
