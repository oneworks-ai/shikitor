{
  "name": "@shikitor/core",
  "version": "1.0.0",
  "description": "Shikitor core",
  "license": "MIT",
  "jiek": {
    "styled": true
  },
  "scripts": {
    "build": "jiek --root ../.. --filter @shikitor/core build",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": "./src/index.ts",
    "./input": "./src/input/index.ts",
    "./plugin": "./src/plugin.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/valtio": "./src/utils/valtio/index.ts",
    "./workers/tokenization": "./src/workers/tokenization.ts",
    "./plugins/code-folding": "./src/plugins/code-folding.ts",
    "./plugins/context-menu": "./src/plugins/context-menu.ts",
    "./plugins/hover-popover": "./src/plugins/hover-popover.ts",
    "./plugins/provide-keyboard": "./src/plugins/provide-keyboard.ts",
    "./plugins/provide-pointer": "./src/plugins/provide-pointer.ts",
    "./plugins/provide-text-input": "./src/plugins/provide-text-input.ts",
    "./plugins/gutter-decorations": "./src/plugins/gutter-decorations.ts",
    "./plugins/line-widgets": "./src/plugins/line-widgets.ts",
    "./plugins/*": ["./src/plugins/*/index.ts", "./src/plugins/*.ts"]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oneworks-ai/shikitor.git",
    "directory": "packages/core",
    "homepage": "https://github.com/oneworks-ai/shikitor/tree/master/packages/core"
  },
  "dependencies": {
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@shikijs/types": "^4.4.3",
    "cordis": "^4.0.0-rc.8",
    "derive-valtio": "^0.1.0",
    "diff": "9.0.0",
    "shiki": "^4.4.3",
    "valtio": "^1.13.2"
  },
  "devDependencies": {
    "@shikitor/core": "workspace:^*"
  },
  "files": [
    "dist",
    ".resource",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*.css": "./dist/*.css",
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "require": "./dist/index.umd.js"
      },
      "./input": {
        "types": "./dist/input.d.ts",
        "import": "./dist/input.esm.js",
        "require": "./dist/input.umd.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.ts",
        "import": "./dist/plugin.esm.js",
        "require": "./dist/plugin.umd.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.esm.js",
        "require": "./dist/types.umd.js"
      },
      "./utils": {
        "types": "./dist/utils.d.ts",
        "import": "./dist/utils.esm.js",
        "require": "./dist/utils.umd.js"
      },
      "./utils/valtio": {
        "types": "./dist/utils/valtio.d.ts",
        "import": "./dist/utils/valtio.esm.js",
        "require": "./dist/utils/valtio.umd.js"
      },
      "./workers/tokenization": {
        "types": "./dist/workers/tokenization.d.ts",
        "import": "./dist/workers/tokenization.esm.js",
        "require": "./dist/workers/tokenization.umd.js"
      },
      "./plugins/*": {
        "types": "./dist/plugins/*.d.ts",
        "import": "./dist/plugins/*.esm.js",
        "require": "./dist/plugins/*.umd.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.umd.js",
    "module": "./dist/index.esm.js",
    "browser": "./dist/index.umd.min.js",
    "typesVersions": {
      "<5.0": {
        "*": [
          "*",
          "./dist/*",
          "./dist/*/index.esm.d.ts"
        ]
      }
    }
  }
}
