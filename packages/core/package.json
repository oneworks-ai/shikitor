    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@shikijs/types": "^4.4.3",
    "cordis": "^4.0.0-rc.8",
    "derive-valtio": "^0.1.0",
    "diff": "9.0.0",
    "shiki": "^4.4.3",
    "valtio": "^1.13.2"
  },
  "devDependencies": {
    "@shikitor/core": "workspace:^*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      "./*.css": "./dist/*.css"
    }
  }
