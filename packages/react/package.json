{
  "name": "@shikitor/react",
  "version": "1.0.2",
  "description": "Shikitor for react",
  "license": "MIT",
  "files": [
    "dist",
    "index.css",
    "LICENSE"
  ],
  "scripts": {
    "build": "jiek --root ../.. --filter @shikitor/react build",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": "./src/index.ts",
    "./WithoutCoreEditor": "./src/WithoutCoreEditor.tsx"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./index.css": "./index.css",
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "require": "./dist/index.umd.js"
      },
      "./WithoutCoreEditor": {
        "types": "./dist/WithoutCoreEditor.d.ts",
        "import": "./dist/WithoutCoreEditor.esm.js",
        "require": "./dist/WithoutCoreEditor.umd.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.umd.js",
    "module": "./dist/index.esm.js",
    "browser": "./dist/index.umd.min.js",
    "typesVersions": {
      "<5.0": {
        "*": [
          "*",
          "./dist/*",
          "./dist/*/index.esm.d.ts"
        ]
      }
    }
  },
  "homepage": "https://github.com/oneworks-ai/shikitor/blob/master/packages/react/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/oneworks-ai/shikitor.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/oneworks-ai/shikitor/issues",
  "peerDependencies": {
    "react": "^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@shikitor/core": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^18.2.75",
    "@shikitor/react": "workspace:^*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
